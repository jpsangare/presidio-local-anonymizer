{
  "manifest_version": 3,
  "name": "MasqueIA",
  "version": "1.0.0",
  "key": "",
  "description": "Anonymise automatiquement vos données personnelles avant de les coller dans une IA. Détecte e-mails, téléphones, NIR, IBAN, cartes bancaires et plus. Fonctionne avec ChatGPT, Claude, Gmail.",
  "author": "jpmsangare",
  "homepage_url": "https://github.com/jpsangare/masqueia",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "clipboardRead",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "app.html"
  },
  "host_permissions": [
    "http://localhost:6677/*",
    "http://127.0.0.1:6677/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "locales.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "app.html"
}
